(module easyeda2kicad:VACTROL-TH_VTL5C3 (layer F.Cu) (tedit 5DC5F6A4)
	(descr "Xvive VTL5C3 axial vactrol, LED + LDR. Four axial leads, TWO OUT EACH END at 5.08mm pitch within a pair; body 9.9 x 8.13mm, leads 0.64mm sq. Lead pairs are placed 12.7mm apart here -- the leads are >12.7mm long and get bent, so pair-to-pair spacing is a board choice, not a package dimension. Pins 1/2 = LED (2 = cathode, marked on the body), 3/4 = photocell, non-polarised. Geometry from the PerkinElmer/Xvive VTL5C3-5C4 datasheet package drawing.")
	(attr through_hole)
	(fp_text reference REF** (at 0.000 -6.500) (layer F.SilkS)
		(effects (font (size 1 1) (thickness 0.15)))
	)
	(fp_text value VTL5C3 (at 0.000 6.500) (layer F.Fab)
		(effects (font (size 1 1) (thickness 0.15)))
	)
	(fp_text user %R (at 0 0) (layer F.Fab)
		(effects (font (size 1 1) (thickness 0.15)))
	)
	(fp_line (start -4.95 -4.07) (end 4.95 -4.07) (layer F.SilkS) (width 0.15))
	(fp_line (start 4.95 -4.07) (end 4.95 4.07) (layer F.SilkS) (width 0.15))
	(fp_line (start 4.95 4.07) (end -4.95 4.07) (layer F.SilkS) (width 0.15))
	(fp_line (start -4.95 4.07) (end -4.95 -4.07) (layer F.SilkS) (width 0.15))
	(fp_line (start -4.95 -4.07) (end 4.95 -4.07) (layer F.Fab) (width 0.10))
	(fp_line (start 4.95 -4.07) (end 4.95 4.07) (layer F.Fab) (width 0.10))
	(fp_line (start 4.95 4.07) (end -4.95 4.07) (layer F.Fab) (width 0.10))
	(fp_line (start -4.95 4.07) (end -4.95 -4.07) (layer F.Fab) (width 0.10))
	(fp_circle (center -6.35 -4.10) (end -6.10 -4.10) (layer F.SilkS) (width 0.25))
	(pad 1 thru_hole rect (at -6.35 -2.54 0.00) (size 1.700 1.700) (layers *.Cu *.Mask)(drill 0.900000))
	(pad 2 thru_hole circle (at -6.35 2.54 0.00) (size 1.700 1.700) (layers *.Cu *.Mask)(drill 0.900000))
	(pad 3 thru_hole circle (at 6.35 -2.54 0.00) (size 1.700 1.700) (layers *.Cu *.Mask)(drill 0.900000))
	(pad 4 thru_hole circle (at 6.35 2.54 0.00) (size 1.700 1.700) (layers *.Cu *.Mask)(drill 0.900000))
	(fp_line (start -7.40 -4.90) (end 7.40 -4.90) (layer F.CrtYd) (width 0.05))
	(fp_line (start 7.40 -4.90) (end 7.40 4.90) (layer F.CrtYd) (width 0.05))
	(fp_line (start 7.40 4.90) (end -7.40 4.90) (layer F.CrtYd) (width 0.05))
	(fp_line (start -7.40 4.90) (end -7.40 -4.90) (layer F.CrtYd) (width 0.05))
)
