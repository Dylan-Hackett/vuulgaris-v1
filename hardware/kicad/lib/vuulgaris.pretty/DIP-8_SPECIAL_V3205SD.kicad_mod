(module easyeda2kicad:DIP-8_SPECIAL_V3205SD (layer F.Cu) (tedit 5DC5F6A4)
	(descr "Coolaudio V3205SD / Panasonic MN3205 -- Special 8-Lead Dual-In-Line. DIP-14 lead pattern (2.54mm pitch, 7.62mm row spacing) with the middle three positions on each side omitted. Chip pins 1-8 sit at DIP-14 positions 1,2,6,7,8,9,13,14 and are numbered 1-8 here. Body 19.2 x 6.4mm. Geometry from the V3205SD datasheet V1.0 mechanical drawing.")
	(attr through_hole)
	(fp_text reference REF** (at 0.000 -11.000) (layer F.SilkS)
		(effects (font (size 1 1) (thickness 0.15)))
	)
	(fp_text value V3205SD (at 0.000 11.000) (layer F.Fab)
		(effects (font (size 1 1) (thickness 0.15)))
	)
	(fp_text user %R (at 0 0) (layer F.Fab)
		(effects (font (size 1 1) (thickness 0.15)))
	)
	(fp_line (start -3.20 -9.60) (end -1.00 -9.60) (layer F.SilkS) (width 0.15))
	(fp_line (start 1.00 -9.60) (end 3.20 -9.60) (layer F.SilkS) (width 0.15))
	(fp_arc (start 0.00 -9.60) (end -1.00 -9.60) (angle 180.00) (layer F.SilkS) (width 0.15))
	(fp_line (start 3.20 -9.60) (end 3.20 9.60) (layer F.SilkS) (width 0.15))
	(fp_line (start 3.20 9.60) (end -3.20 9.60) (layer F.SilkS) (width 0.15))
	(fp_line (start -3.20 9.60) (end -3.20 -9.60) (layer F.SilkS) (width 0.15))
	(fp_circle (center -3.81 -9.10) (end -3.56 -9.10) (layer F.SilkS) (width 0.25))
	(fp_line (start -3.20 -9.60) (end 3.20 -9.60) (layer F.Fab) (width 0.10))
	(fp_line (start 3.20 -9.60) (end 3.20 9.60) (layer F.Fab) (width 0.10))
	(fp_line (start 3.20 9.60) (end -3.20 9.60) (layer F.Fab) (width 0.10))
	(fp_line (start -3.20 9.60) (end -3.20 -9.60) (layer F.Fab) (width 0.10))
	(pad 1 thru_hole rect (at -3.81 -7.62 0.00) (size 1.600 1.600) (layers *.Cu *.Mask)(drill 0.900000))
	(pad 2 thru_hole circle (at -3.81 -5.08 0.00) (size 1.600 1.600) (layers *.Cu *.Mask)(drill 0.900000))
	(pad 3 thru_hole circle (at -3.81 5.08 0.00) (size 1.600 1.600) (layers *.Cu *.Mask)(drill 0.900000))
	(pad 4 thru_hole circle (at -3.81 7.62 0.00) (size 1.600 1.600) (layers *.Cu *.Mask)(drill 0.900000))
	(pad 5 thru_hole circle (at 3.81 7.62 0.00) (size 1.600 1.600) (layers *.Cu *.Mask)(drill 0.900000))
	(pad 6 thru_hole circle (at 3.81 5.08 0.00) (size 1.600 1.600) (layers *.Cu *.Mask)(drill 0.900000))
	(pad 7 thru_hole circle (at 3.81 -5.08 0.00) (size 1.600 1.600) (layers *.Cu *.Mask)(drill 0.900000))
	(pad 8 thru_hole circle (at 3.81 -7.62 0.00) (size 1.600 1.600) (layers *.Cu *.Mask)(drill 0.900000))
	(fp_line (start -4.70 -10.40) (end 4.70 -10.40) (layer F.CrtYd) (width 0.05))
	(fp_line (start 4.70 -10.40) (end 4.70 10.40) (layer F.CrtYd) (width 0.05))
	(fp_line (start 4.70 10.40) (end -4.70 10.40) (layer F.CrtYd) (width 0.05))
	(fp_line (start -4.70 10.40) (end -4.70 -10.40) (layer F.CrtYd) (width 0.05))
